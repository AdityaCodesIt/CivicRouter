# ==============================================================================
# RouteWala - Environment Configuration Template
# ==============================================================================

# Supabase Backend Configuration
# Obtain these from your Supabase Dashboard -> Project Settings -> API
# NOTE: Only the anon/publishable public key is ever used in the frontend. Never provide service_role key.
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-or-anon-key"
VITE_SUPABASE_ANON_KEY="your-publishable-or-anon-key"

# Google Gemini AI API Key (Used for unstructured manifest parsing & AI features)
# Obtain from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=""

# Application Host URL
APP_URL="http://localhost:3000"
